#!/bin/bash
# SPDX-License-Identifier: BSD-3-Clause
#
# Rotates the internal screen, touchscreen and pen input with the accelerometer, for Hyprland.
# Follows iio-sensor-proxy's orientation through monitor-sensor. Runs in the graphical session
# (sp11-autorotate.service, a user unit); the session's polkit rules allow claiming the sensor.
#
#   SP11_AUTOROTATE_OUTPUT   monitor to rotate (default: eDP-1)
#   ~/.config/sp11-autorotate/disabled   rotation lock: while this file exists, keep the screen as it
#                                        is and release the accelerometer, so iio-sensor-proxy stops
#                                        the ADSP sensor stream (~5 wakeups/s while claimed)
set -uo pipefail

output=${SP11_AUTOROTATE_OUTPUT:-eDP-1}
cfgdir=${XDG_CONFIG_HOME:-$HOME/.config}/sp11-autorotate
disabled=$cfgdir/disabled
mkdir -p "$cfgdir"

transform_for() {
  case $1 in
    normal) echo 0 ;;
    left-up) echo 1 ;;
    bottom-up) echo 2 ;;
    right-up) echo 3 ;;
    *) return 1 ;;
  esac
}

apply() {
  local t=$1 scale
  scale=$(hyprctl monitors -j | jq -r --arg o "$output" '.[] | select(.name == $o) | .scale')
  [[ -n $scale ]] || return 0   # monitor not present (e.g. closed lid with an external display)
  hyprctl eval "hl.monitor({ output = \"$output\", mode = \"preferred\", position = \"auto\", scale = $scale, transform = $t })" >/dev/null
  hyprctl eval "hl.config({ input = { touchdevice = { transform = $t, output = \"$output\" }, tablet = { transform = $t, output = \"$output\" } } })" >/dev/null
}

# iio-sensor-proxy only enables the accelerometer for a claim that arrives after the driver has
# probed; monitor-sensor claims the moment the proxy appears on the bus, which can be earlier (e.g.
# when the proxy restarts), and then no orientation ever arrives. So wait until the proxy reports
# the accelerometer before claiming, and start over whenever the proxy goes away.
has_accelerometer() {
  gdbus call --system --dest net.hadess.SensorProxy --object-path /net/hadess/SensorProxy \
    --method org.freedesktop.DBus.Properties.Get net.hadess.SensorProxy HasAccelerometer 2>/dev/null \
    | grep -q true
}

# Waits for the lock file to change ($1: create or delete); the timeout is only a backstop.
wait_flag() {
  local ev=(-e create -e moved_to)
  [[ $1 == delete ]] && ev=(-e delete -e moved_from)
  inotifywait -qq -t 60 "${ev[@]}" --include '/disabled$' "$cfgdir" 2>/dev/null
}

current=""
while true; do
  if [[ -e $disabled ]]; then
    while [[ -e $disabled ]]; do wait_flag delete; done
    current=""   # someone else may have rotated the screen meanwhile; follow the sensor again
  fi
  until has_accelerometer; do sleep 2; [[ -e $disabled ]] && continue 2; done

  coproc sensor { exec monitor-sensor --accel 2>/dev/null; }
  sensor_pid=$sensor_PID   # bash unsets sensor_PID once the coproc exits
  # Locking ends monitor-sensor, which drops the claim; the loop below then sees EOF.
  ( until [[ -e $disabled ]]; do wait_flag create; done; kill "$sensor_pid" 2>/dev/null ) &
  watcher=$!
  [[ -e $disabled ]] && kill "$sensor_pid" 2>/dev/null
  while read -r line <&"${sensor[0]}"; do
    case $line in
      *"iio-sensor-proxy vanished"*)
        break
        ;;
      *"Accelerometer orientation changed:"*|*"Has accelerometer (orientation:"*)
        orientation=${line##*: }
        orientation=${orientation%%,*}
        orientation=${orientation%%)*}
        t=$(transform_for "$orientation") || continue
        [[ -e $disabled ]] && continue
        [[ $t == "$current" ]] && continue
        apply "$t" && current=$t
        ;;
    esac
  done
  pkill -P "$watcher" -x inotifywait 2>/dev/null; kill "$watcher" 2>/dev/null
  kill "$sensor_pid" 2>/dev/null
  wait "$sensor_pid" "$watcher" 2>/dev/null
  [[ -e $disabled ]] || sleep 2
done
